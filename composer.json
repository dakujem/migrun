{
  "name": "dakujem/migrun",
  "description": "Lightweight, flexible, framework-and-database-agnostic migration runner.",
  "type": "library",
  "license": "Unlicense",
  "keywords": ["migration", "runner", "database", "schema"],
  "authors": [
    {
      "name": "Andrej Rypák",
      "email": "xrypak@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "psr/container": "^2.0"
  },
  "suggest": {
    "psr/container": ">=1.0 — required for ContainerInvoker autowiring support"
  },
  "autoload": {
    "psr-4": {
      "Dakujem\\Migrun\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dakujem\\Migrun\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@test:local",
    "test:local": "@php vendor/bin/phpunit",
    "test:ci": "phpunit"
  },
  "scripts-descriptions": {
    "test": "Run application tests. (defaults to local tests)",
    "test:local": "Run application tests with local configuration.",
    "test:ci": "Run application tests, provide configuration options as needed."
  },
  "archive": {
    "exclude": ["/tests", "/.github"]
  }
}
